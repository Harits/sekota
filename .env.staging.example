# Staging stack: staging domain, TLS via Caddy profile or external ingress.
# Copy to .env.staging and edit DOMAIN/CORS and mail settings.
COMPOSE_PROJECT_NAME=sekota-staging
CONTAINER_NAME=sekota-staging
IMAGE_NAME=sekota-web
IMAGE_TAG=staging

# Keep the app private: only Caddy (or the ingress) publishes 80/443.
BIND_ADDR=127.0.0.1
PORT=8080
HTTP_PORT=80
HTTPS_PORT=443
DOMAIN=staging.sekota.id
# Let's Encrypt staging CA: avoids production rate limits, certificate is not
# trusted by browsers (expected for staging). Use the production URL to change.
ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory

SEKOTA_ALLOWED_ORIGINS=https://staging.sekota.id

# Option A (test): leave SMTP empty and use FormSubmit below.
# Option B (recommended): fill SMTP and clear SEKOTA_FORMSUBMIT_TO.
SEKOTA_SMTP_HOST=
SEKOTA_SMTP_PORT=587
SEKOTA_SMTP_USER=
SEKOTA_SMTP_PASSWORD=
SEKOTA_SMTP_STARTTLS=true
SEKOTA_MAIL_FROM=
SEKOTA_MAIL_TO=info@sekota.id

SEKOTA_FORMSUBMIT_TO=staging-qa@example.com
SEKOTA_FORMSUBMIT_ORIGIN=https://staging.sekota.id

MEM_LIMIT=1g
CPU_LIMIT=1.0
