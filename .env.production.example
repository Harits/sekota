# Production stack: real traffic, SMTP required, stricter CORS and limits.
# Copy to .env.production, edit, then: chmod 600 .env.production
COMPOSE_PROJECT_NAME=sekota
CONTAINER_NAME=sekota
IMAGE_NAME=sekota-web
# Change per release; also used for rollback to a previously built image.
IMAGE_TAG=2026.11.26

# Only Caddy (or an external ingress) is public; the app stays on loopback.
BIND_ADDR=127.0.0.1
PORT=8080
HTTP_PORT=80
HTTPS_PORT=443
DOMAIN=sekota.id
ACME_CA=https://acme-v02.api.letsencrypt.org/directory

# Exact production origin only.
SEKOTA_ALLOWED_ORIGINS=https://sekota.id

# SMTP is mandatory in production (SPF/DKIM/DMARC configured at the provider).
# Fill host/user/password before the first start; leaving host empty returns 503.
SEKOTA_SMTP_HOST=
SEKOTA_SMTP_PORT=587
SEKOTA_SMTP_USER=no-reply@sekota.id
SEKOTA_SMTP_PASSWORD=CHANGE_ME
SEKOTA_SMTP_STARTTLS=true
SEKOTA_MAIL_FROM=no-reply@sekota.id
SEKOTA_MAIL_TO=info@sekota.id

# FormSubmit must stay disabled in production.
SEKOTA_FORMSUBMIT_TO=
SEKOTA_FORMSUBMIT_ORIGIN=

MEM_LIMIT=1536m
CPU_LIMIT=2.0
LOG_MAX_SIZE=10m
LOG_MAX_FILE=5
