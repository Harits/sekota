@startuml
!theme plain
left to right direction
skinparam backgroundColor #FFFFFF
skinparam packageStyle rectangle
skinparam roundcorner 12
skinparam shadowing false
skinparam defaultFontName "DM Sans"
skinparam nodesep 40
skinparam ranksep 50

skinparam actor {
    BackgroundColor #F7FAFB
    BorderColor #0D1F2D
    FontColor #0D1F2D
    FontStyle bold
}

skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor #00B5C8
    BorderThickness 1.5
    ArrowColor #0D1F2D
    FontColor #0D1F2D
}

skinparam package {
    BackgroundColor #F7FAFB
    BorderColor #0D1F2D
    FontColor #0D1F2D
    FontStyle bold
}

actor "Pembaca Publik\n(Reader)" as Reader
actor "Klien Korporat\nB2B/B2G" as CorporateClient
actor "Admin Sistem\n(Sekota CMS)" as SysAdmin
actor "Sync Engine\n(WebSocket)" as SyncEngine
actor "Master Inventory System\n(bookinteractiontool / Ops)" as MasterTool <<secondary system>>

rectangle "Sekota Web Platform" {

    package "Autentikasi & Akun Pengguna (Auth & Identity)" {
        usecase "UC-AUTH-01: Registrasi Pembaca Baru\n(Default READER Identity via /auth/register)" as UC_AUTH_01
        usecase "UC-AUTH-02: Masuk Akun Pengguna & Penerbitan JWT\n(/auth/login)" as UC_AUTH_02
        usecase "UC-AUTH-03: Manajemen Profil & Sesi Persisten" as UC_AUTH_03
        usecase "Penyimpanan Token & Cache Persisten (SQLDelight)" as UC_STORAGE
        usecase "Verifikasi Kredensial & Validasi JWT (Ktor Server)" as UC_VERIFY
    }

    package "Thought Leadership, E-Book & Keterlibatan Pembaca" {
        usecase "UC-BOOK-01: Interaksi Rincian Buku Dinamis:\nAksi 'Read Now' (PDF), Bintang Pembaca,\n& 'Add to Library'" as UC_BOOK_01
        usecase "UC-BOOK-02: Eksplorasi Bento Grid\n(Bab Kunci & Profil Penulis Putu Aan J.)" as UC_BOOK_02
        usecase "UC-CAT-01: Pencarian & Filter Multikategori E-Book\n(Genre, Kategori, Rating, Sortir)" as UC_CAT_01
    }

    package "B2B/B2G Leads, Konsultasi & Merchandise" {
        usecase "UC-LEAD-01: Pengajuan Permintaan Konsultasi Strategis\n(Formulir Kontak Landing Page Budi Santoso)" as UC_LEAD_01
        usecase "UC-MERCH-01: Eksplorasi Merchandise &\nPengajuan Solusi Kustom (Customize Solution)" as UC_MERCH_01
    }

    package "Auth-Gating & Perlindungan Aksi (Phase 1 Refinement)" {
        usecase "UC-GATE-01: Validasi Autentikasi Modal Inline\n(Auth-Gated Read, Download & Order)" as UC_GATE_01
        usecase "Inline Auth Modal Dialog\n(Sign In / Create Identity Switcher)" as UC_AUTH_MODAL
    }

    package "CMS Pengelola Tri-Platform (Desktop, Android & CLI)" {
        usecase "UC-CMS-01: Tata Kelola Produk, Manuskrip\nBuku, dan Merchandise" as UC_CMS_01
        usecase "Sinkronisasi Master Buku Inventory\n(View-Only GET /admin/books via Operation Tool)" as UC_CMS_BOOKS
        usecase "Kelola Tampilan Web & Metadata Buku\n(Kategori, Rating Bintang, Unduh PDF, Sinopsis)" as UC_CMS_WEB_META
        usecase "Pengelolaan Ekosistem Produk\n(Veridia, Ascendio, Sociara, Ecoflow)" as UC_CMS_PRODUCTS
        usecase "Pengelolaan Inventaris Merchandise\n(T-Shirt, Pin, Sticker, Pricing)" as UC_CMS_MERCH
    }

    package "Lokalisasi & Pengalaman Global" {
        usecase "UC-I18N-01: Pengalihan Bahasa Antarmuka\n(English / Bahasa Indonesia)" as UC_I18N_01
    }

    package "Real-Time Synchronization & Backend Services" {
        usecase "UC-SYNC-01: Sinkronisasi Status Sesi Real-Time\n(WebSocket /ws/sync)" as UC_SYNC_01
        usecase "UC-ADM-01: Pemantauan Sesi, Audit Keamanan\n& Tata Kelola Platform" as UC_ADM_01
    }
}

' Reader Associations
Reader --> UC_AUTH_01
Reader --> UC_AUTH_02
Reader --> UC_AUTH_03
Reader --> UC_BOOK_01
Reader --> UC_BOOK_02
Reader --> UC_CAT_01
Reader --> UC_MERCH_01
Reader --> UC_I18N_01
Reader --> UC_GATE_01

' Corporate Client Associations
CorporateClient --> UC_AUTH_02
CorporateClient --> UC_AUTH_03
CorporateClient --> UC_LEAD_01
CorporateClient --> UC_BOOK_01
CorporateClient --> UC_BOOK_02
CorporateClient --> UC_CAT_01
CorporateClient --> UC_MERCH_01
CorporateClient --> UC_I18N_01
CorporateClient --> UC_GATE_01

' Admin System Associations
SysAdmin --> UC_AUTH_02
SysAdmin --> UC_ADM_01
SysAdmin --> UC_CMS_01

' Secondary System Associations
MasterTool ..> UC_CMS_BOOKS : <<master data source>>

' Sync Engine Associations
SyncEngine --> UC_SYNC_01

' Includes & Extends
UC_AUTH_01 ..> UC_STORAGE : <<include>>
UC_AUTH_01 ..> UC_VERIFY : <<include>>
UC_AUTH_02 ..> UC_STORAGE : <<include>>
UC_AUTH_02 ..> UC_VERIFY : <<include>>
UC_AUTH_03 ..> UC_STORAGE : <<include>>
UC_AUTH_03 ..> UC_VERIFY : <<include>>

UC_GATE_01 ..> UC_AUTH_MODAL : <<include>>
UC_BOOK_01 ..> UC_GATE_01 : <<extend>>\n(Guest Read/PDF Download)
UC_MERCH_01 ..> UC_GATE_01 : <<extend>>\n(Guest Order Action)
UC_MERCH_01 ..> UC_LEAD_01 : <<extend>>\n(Customize Solution CTA)
UC_SYNC_01 ..> UC_AUTH_03 : <<include>>

UC_CMS_01 ..> UC_CMS_BOOKS : <<include>>
UC_CMS_01 ..> UC_CMS_WEB_META : <<include>>
UC_CMS_01 ..> UC_CMS_PRODUCTS : <<include>>
UC_CMS_01 ..> UC_CMS_MERCH : <<include>>
UC_CMS_01 ..> UC_AUTH_02 : <<include>>\n(Requires ADMIN/BOD Role)

@enduml
