# Figma Configuration

# Your Figma Personal Access Token
FIGMA_ACCESS_TOKEN=your_personal_access_token_here

# The file key of the main design file
# e.g., if the URL is https://www.figma.com/design/ABCD123/Sekota-Web-UI, the key is ABCD123
FIGMA_FILE_KEY=your_figma_file_key_here

# Optional: Default Node ID for the main web UI frame
FIGMA_WEB_UI_NODE_ID=0:1
