# Development stack: http://localhost:8090, FormSubmit fallback, no TLS.
# Copy to .env.development and edit the FormSubmit recipient.
COMPOSE_PROJECT_NAME=sekota-dev
CONTAINER_NAME=sekota-dev
IMAGE_NAME=sekota-web
IMAGE_TAG=dev

BIND_ADDR=0.0.0.0
PORT=8090
HTTP_PORT=8080
HTTPS_PORT=8443
DOMAIN=localhost

# Relaxed CORS for local web work (Compose stack and static dev server).
SEKOTA_ALLOWED_ORIGINS=http://localhost:8090,http://127.0.0.1:8090,http://localhost:8765,http://127.0.0.1:8765

# No SMTP: delivery goes through FormSubmit.
SEKOTA_SMTP_HOST=
SEKOTA_SMTP_PORT=587
SEKOTA_SMTP_USER=
SEKOTA_SMTP_PASSWORD=
SEKOTA_SMTP_STARTTLS=true
SEKOTA_MAIL_FROM=
SEKOTA_MAIL_TO=info@sekota.id

# Replace with a mailbox whose FormSubmit activation email you can open.
# Keep ORIGIN as https://sekota.id so the already-activated form is reused;
# changing it (for example to http://localhost:8090) requires a new activation.
SEKOTA_FORMSUBMIT_TO=dev-test@example.com
SEKOTA_FORMSUBMIT_ORIGIN=https://sekota.id

# Small local footprint.
MEM_LIMIT=1g
CPU_LIMIT=1.0
