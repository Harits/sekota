# Sekota deployment environment template.
# Copy to .env.<environment> (for example .env.production) and edit.
# Never commit a filled-in env file. Quote values that contain spaces.
# A literal dollar sign in a value must be written as $$ (Compose interpolation).
#
# Container always listens on 8080; PORT is the HOST port only.
# PORT/CONTAINER_NAME/COMPOSE_PROJECT_NAME isolate multiple stacks on one host.

# --- Stack identity ---------------------------------------------------------
COMPOSE_PROJECT_NAME=sekota
CONTAINER_NAME=sekota
IMAGE_NAME=sekota-web
IMAGE_TAG=local

# --- Network ----------------------------------------------------------------
# BIND_ADDR=127.0.0.1 keeps the app private behind Caddy or an external ingress.
# Use 0.0.0.0 only for a local development stack you intentionally expose.
BIND_ADDR=127.0.0.1
PORT=8080
# Host ports for the optional Caddy proxy profile (rootless Podman cannot bind
# ports below 1024 without sysctl; see docs/13-deployment.md).
HTTP_PORT=80
HTTPS_PORT=443

# --- TLS / Caddy ------------------------------------------------------------
# Bare hostname, no scheme. Use "localhost" for local HTTPS with Caddy's
# internal CA; use a public DNS name for Let's Encrypt.
DOMAIN=sekota.id
# Staging: https://acme-staging-v02.api.letsencrypt.org/directory
ACME_CA=https://acme-v02.api.letsencrypt.org/directory

# --- CORS -------------------------------------------------------------------
# Same-origin deployments do not need CORS. If the UI is on another origin,
# list exact origins, comma-separated. Wildcards are not supported.
SEKOTA_ALLOWED_ORIGINS=https://sekota.id

# --- SMTP (preferred for production) ---------------------------------------
# When SEKOTA_SMTP_HOST is set, SMTP is used and FormSubmit is ignored.
# Use port 587 with STARTTLS. Implicit TLS (port 465) is not supported by the
# current server code; it would need an application change.
SEKOTA_SMTP_HOST=
SEKOTA_SMTP_PORT=587
SEKOTA_SMTP_USER=
SEKOTA_SMTP_PASSWORD=
SEKOTA_SMTP_STARTTLS=true
SEKOTA_MAIL_FROM=
SEKOTA_MAIL_TO=info@sekota.id

# --- FormSubmit fallback (test only) ---------------------------------------
# Leave empty in production. The recipient must activate the form once.
# Mail can land in Spam and passes through a third party.
SEKOTA_FORMSUBMIT_TO=
SEKOTA_FORMSUBMIT_ORIGIN=https://sekota.id

# --- Resources / logs (used by staging and production overrides) -----------
MEM_LIMIT=1536m
CPU_LIMIT=2.0
LOG_MAX_SIZE=10m
LOG_MAX_FILE=5

# --- JVM (optional) ---------------------------------------------------------
# Leave commented to use the default set in compose.yaml / Dockerfile.
# JAVA_OPTS=-XX:InitialRAMPercentage=20 -XX:MaxRAMPercentage=60 -XX:+ExitOnOutOfMemoryError -Dfile.encoding=UTF-8

# Outbound proxy for FormSubmit (Java HttpClient does not read HTTPS_PROXY):
# append to JAVA_OPTS, for example:
# -Dhttps.proxyHost=proxy.example -Dhttps.proxyPort=3128 -Dhttp.nonProxyHosts=localhost^|127.0.0.1
